---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Levente Lokos, Computer Science student and full-stack developer. Portfolio of web projects built with Angular, React, and Astro." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="antialiased overflow-x-hidden">
    <div id="preloader" class="preloader" aria-hidden="true">
      <div class="preloader-text">LEVENTE LOKOS</div>
      <div class="preloader-bar"><span></span></div>
    </div>
    <slot />
    <script>
      const preloaderStart = performance.now();
      const MIN_PRELOADER_MS = 1100;

      function reveal() {
        document.documentElement.classList.add('loaded');
        setTimeout(() => document.getElementById('preloader')?.remove(), 500);
      }
      function revealAfterMinimum() {
        const remaining = MIN_PRELOADER_MS - (performance.now() - preloaderStart);
        setTimeout(reveal, Math.max(0, remaining));
      }
      if (document.readyState === 'complete') {
        revealAfterMinimum();
      } else {
        window.addEventListener('load', revealAfterMinimum);
      }
      setTimeout(reveal, 3000);
    </script>
  </body>
</html>